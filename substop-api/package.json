{
  "name": "substop-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --port 8787",
    "deploy": "wrangler deploy",
    "types": "wrangler types --include-runtime false",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/*.test.ts",
    "migrate:local": "wrangler d1 migrations apply substop-db --local",
    "migrate:remote": "wrangler d1 migrations apply substop-db --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261107.1",
    "typescript": "^5.6.3",
    "wrangler": "^4.45.0"
  }
}
